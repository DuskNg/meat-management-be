// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL") // --- VẤN ĐỀ 1: Thêm dòng connection string theo yêu cầu (đã comment out để tương thích với Prisma v7) ---
}

model User {
  id        String   @id @default(uuid())
  name      String   // Tên hiển thị của chủ buôn
  phone     String   @unique // Số điện thoại dùng làm tài khoản đăng nhập (duy nhất)
  pin       String?  // Mã PIN bảo mật đã được băm (4 số)
  
  // Các trường phục vụ Admin và Phân quyền
  isAdmin            Boolean  @default(false)
  password           String?  // Mật khẩu mã hóa cho tài khoản Admin
  canManageCustomers Boolean  @default(false)
  canManageDebt      Boolean  @default(false)
  canManageBadDebt   Boolean  @default(false)
  canManageEmployees Boolean  @default(false)
  canManageStore     Boolean  @default(false) // Quyền quản lý cửa hàng (bàn, món ăn)
  canManageInventory Boolean  @default(false) // Quyền quản lý kho (sản phẩm, tồn kho)
  canManageShop      Boolean  @default(false) // Quyền quản lý cửa hàng tính giờ (bida, karaoke...)
  isActive           Boolean  @default(true)  // Trạng thái hoạt động (cho phép xóa mềm)
  deletedAt          DateTime?                // Thời điểm xóa tài khoản tạm thời
  isWorkspaceOwner   Boolean  @default(false) // Admin đánh dấu tài khoản này được phép tạo Workspace

  createdAt DateTime @default(now()) // Thời gian tạo tài khoản
  updatedAt DateTime @updatedAt // Thời gian tự động cập nhật mỗi khi thay đổi thông tin

  // Các quan hệ liên kết
  customers    Customer[]    // Một chủ buôn quản lý nhiều khách hàng
  products     Product[]     // Một chủ buôn quản lý danh mục sản phẩm/thịt riêng
  transactions Transaction[] // Các giao dịch được ghi nhận bởi chủ buôn này
  suppliers    Supplier[]    // Một chủ buôn quản lý nhiều nhà cung cấp tiền hàng
  employees    Employee[]    // Một chủ buôn quản lý nhiều nhân viên sạp hàng
  activityLogs ActivityLog[] // Nhật ký hoạt động của chủ buôn này
  inventoryProducts InventoryProduct[] // Các sản phẩm trong kho của chủ buôn này
  inventoryLogs     InventoryLog[]     // Lịch sử biến động nhập/xuất/điều chỉnh kho
  shopTables   ShopTable[]
  shopSessions ShopSession[]
  recurringDebts RecurringDebt[] // Danh sách các mẫu đơn nợ cố định hàng ngày của chủ buôn
  portalLinks    PortalLink[]    // Danh sách các link ghim Zalo của chủ buôn này
  transactionInvoices TransactionInvoice[] // Danh sách các ảnh hóa đơn do chủ buôn này quản lý
  staffSubmissionLinks StaffSubmissionLink[] // Danh sách link Zalo nhân viên gửi hóa đơn
  staffSubmissions     StaffSubmission[]     // Danh sách các lượt nộp hóa đơn/video của nhân viên
  // Quan hệ Workspace
  ownedWorkspace       Workspace?             @relation("WorkspaceOwner")         // Workspace mà user này làm chủ
  workspaceMemberships WorkspaceMember[]      @relation("WorkspaceMembers")        // Các workspace mà user này là thành viên
  workspaceJoinRequests WorkspaceJoinRequest[] @relation("WorkspaceJoinRequests")  // Các yêu cầu tham gia workspace

  @@map("users") // Đặt tên bảng trong PostgreSQL là "users"
}

model OTP {
  id        String    @id @default(uuid())
  phone     String    // Số điện thoại nhận mã xác thực OTP
  code      String    // Mã xác thực OTP (thường là 4 hoặc 6 chữ số)
  expiresAt DateTime  // Thời điểm mã OTP hết hiệu lực (5 phút từ khi tạo)
  usedAt    DateTime? // Thời điểm mã OTP được kích hoạt thành công
  createdAt DateTime  @default(now()) // Thời điểm gửi mã OTP

  @@index([phone]) // Đánh chỉ mục số điện thoại để tối ưu tốc độ tìm kiếm mã OTP gần nhất
  @@map("otps") // Đặt tên bảng trong PostgreSQL là "otps"
}

model Customer {
  id        String   @id @default(uuid())
  userId    String   // ID của chủ buôn quản lý khách hàng này
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy String?  // ID của người trực tiếp tạo bản ghi này
  name      String   // Tên khách hàng (ví dụ: Chị Lan bán phở, Anh Hùng nhà hàng)
  phone     String?  // Số điện thoại liên hệ (có thể để trống)
  address   String?  // Địa chỉ giao hàng/cửa hàng của khách
  note      String?  // Ghi chú chi tiết (ví dụ: chỉ lấy sườn non buổi sáng, thanh toán cuối tuần)
  
  // --- VẤN ĐỀ 2: Thêm isActive để phục vụ Soft Delete ---
  isActive    Boolean  @default(true) // Trạng thái hoạt động. Chức năng "xóa khách hàng" ở app sẽ set isActive = false (soft delete), KHÔNG gọi DELETE thật trên Customer để bảo toàn lịch sử nợ.
  isBadDebt   Boolean  @default(false) // Trạng thái nợ xấu (khoanh vùng lưu trữ)
  manualDebt  Decimal  @default(0) @db.Decimal(12, 2) // Số tiền nợ ban đầu được nhập thủ công (dành cho khách nợ xấu không có lịch sử giao dịch)
  type        String   @default("customer") // Phân loại: "customer" (Khách hàng) hoặc "store" (Bàn ăn cửa hàng)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Các quan hệ liên kết
  transactions Transaction[] // Một khách hàng có nhiều giao dịch mua hàng theo thời gian
  
  // --- VẤN ĐỀ 3: Di chuyển quan hệ Payment từ Transaction sang Customer ---
  payments     Payment[]     // Danh sách các đợt thanh toán nợ của khách hàng này
  customPrices CustomerProductPrice[] // Danh sách giá bán riêng của khách hàng này cho từng loại thịt
  recurringDebts RecurringDebt[] // Các đơn nợ cố định hàng ngày của khách hàng này
  portalLinkCustomers PortalLinkCustomer[] // Các liên kết link ghim Zalo tới khách hàng này
  portalFeedbacks     PortalFeedback[]     // Các phản hồi khiếu nại liên quan đến khách hàng này
  invoices            TransactionInvoice[] // Các ảnh hóa đơn đính kèm của khách hàng này
  staffSubmissions    StaffSubmission[]    // Các hóa đơn/video AI nhận diện của khách hàng này

  @@index([userId]) // Tối ưu hóa truy vấn tìm kiếm danh sách khách hàng của từng chủ buôn
  @@map("customers") // Đặt tên bảng trong PostgreSQL là "customers"
}

model Product {
  id           String            @id @default(uuid())
  userId       String            // ID của chủ buôn sở hữu sản phẩm này
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy    String?           // ID của người trực tiếp tạo bản ghi này
  name         String            // Tên sản phẩm thịt (ví dụ: Ba chỉ, Sườn non, Móng giò)
  defaultPrice Decimal           @db.Decimal(12, 2) // Giá bán mặc định trên một đơn vị (VND)
  costPrice    Decimal           @default(0) @db.Decimal(12, 2) // Giá nhập / giá vốn mặc định trên một đơn vị (VND)
  unit         String            @default("kg") // Đơn vị tính (mặc định là kg, có thể là "bộ", "cái")
  isActive     Boolean           @default(true) // Trạng thái kích hoạt (cho phép ẩn khi không còn bán nữa)
  type         String            @default("customer") // Phân loại: "customer" (Sản phẩm thịt) hoặc "store" (Món ăn thực đơn)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Các quan hệ liên kết
  transactionItems TransactionItem[] // Danh sách các chi tiết dòng đơn hàng sử dụng sản phẩm này
  customPrices     CustomerProductPrice[] // Danh sách giá bán riêng của sản phẩm này cho từng khách hàng
  recurringDebtItems RecurringDebtItem[] // Danh sách dòng đơn nợ cố định sử dụng sản phẩm này

  @@index([userId]) // Tối ưu hóa truy vấn danh mục sản phẩm theo chủ buôn
  @@map("products") // Đặt tên bảng trong PostgreSQL là "products"
}

model Transaction {
  id            String   @id @default(uuid())
  userId        String   // ID của chủ buôn tạo giao dịch
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy     String?  // ID của người trực tiếp tạo bản ghi này
  customerId    String   // ID của khách hàng mua sản phẩm
  
  // --- VẤN ĐỀ 2: Đổi onDelete: Cascade sang Restrict để chặn xóa cứng Customer khi còn đơn nợ ---
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict) 
  
  date          DateTime @default(now()) // Ngày thực hiện giao dịch mua bán
  note          String?  // Ghi chú riêng cho đơn hàng này
  totalAmount   Decimal  @db.Decimal(12, 2) // Tổng giá trị đơn hàng sau khi tính tổng các dòng
  profitPercent Decimal? @db.Decimal(5, 2) // % lợi nhuận áp dụng cho đơn nợ nhanh (ví dụ: 15.00%)
  totalCost     Decimal  @default(0) @db.Decimal(12, 2) // Tổng tiền vốn đơn hàng
  totalProfit   Decimal  @default(0) @db.Decimal(12, 2) // Tổng tiền lãi / lợi nhuận đơn hàng
  type          String   @default("customer") // Phân loại: "customer" (Hóa đơn mua thịt) hoặc "store" (Hóa đơn cửa hàng)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Các quan hệ liên kết
  items    TransactionItem[] // Danh sách chi tiết các loại thịt được bán trong giao dịch này
  invoices TransactionInvoice[] // Danh sách ảnh chụp hóa đơn đính kèm đơn nợ này
  
  // --- VẤN ĐỀ 3: Đã bỏ quan hệ trực tiếp "payments" tại đây ---

  @@index([userId])
  @@index([customerId])
  @@index([date]) // Tối ưu hóa lọc lịch sử giao dịch theo ngày
  @@map("transactions") // Đặt tên bảng trong PostgreSQL là "transactions"
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String      // ID của giao dịch chứa dòng sản phẩm này
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String      // ID của sản phẩm thịt
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict) // Không cho phép xoá cứng Product nếu đã có giao dịch sử dụng để bảo toàn dữ liệu lịch sử nợ
  quantity      Decimal     @db.Decimal(10, 3) // Khối lượng hoặc số lượng bán (ví dụ: 1.255 kg)
  price         Decimal     @db.Decimal(12, 2) // Giá bán thực tế lúc đó (có thể thương lượng khác giá mặc định)
  costPrice     Decimal     @default(0) @db.Decimal(12, 2) // Giá nhập / giá vốn tại thời điểm bán
  amount        Decimal     @db.Decimal(12, 2) // Thành tiền cho dòng này (= quantity * price)
  profit        Decimal     @default(0) @db.Decimal(12, 2) // Tiền lãi của dòng này (= amount - quantity * costPrice)

  @@index([transactionId])
  @@index([productId])
  @@map("transaction_items") // Đặt tên bảng trong PostgreSQL là "transaction_items"
}

model Payment {
  id            String      @id @default(uuid())
  
  // --- VẤN ĐỀ 3: Chuyển quan hệ thanh toán từ liên kết Transaction sang Customer ---
  customerId    String      // ID của khách hàng thanh toán tiền
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy     String?     // ID của người trực tiếp tạo bản ghi này
  
  amount        Decimal     @db.Decimal(12, 2) // Số tiền trả trong đợt này (VND)
  paidAt        DateTime    @default(now()) // Thời điểm thanh toán tiền
  note          String?     // Ghi chú thanh toán (ví dụ: trả tiền mặt tại sạp, chuyển khoản Vietcombank)
  type          String      @default("customer") // Phân loại: "customer" (Trả tiền thịt) hoặc "store" (Thanh toán bàn cửa hàng)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // --- VẤN ĐỀ 3: Ghi chú cách tính công nợ ---
  // Công nợ của 1 khách = tổng totalAmount của tất cả Transaction của khách trừ tổng amount của tất cả Payment của khách, KHÔNG phân bổ theo từng đơn cụ thể.

  @@index([customerId])
  @@map("payments") // Đặt tên bảng trong PostgreSQL là "payments"
}

model CustomerProductPrice {
  id          String   @id @default(uuid())
  customerId  String   // ID của khách hàng
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId   String   // ID của sản phẩm thịt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price       Decimal  @db.Decimal(12, 2) // Giá bán thực tế được cập nhật gần nhất cho khách hàng này
  costPrice   Decimal? @db.Decimal(12, 2) // Giá nhập riêng cho khách hàng này nếu có
  createdAt   DateTime @default(now()) // Thời điểm tạo bản ghi
  updatedAt   DateTime @updatedAt // Thời điểm cập nhật giá lần gần nhất

  @@unique([customerId, productId]) // Mỗi khách hàng chỉ có duy nhất một giá bán riêng cho mỗi sản phẩm
  @@index([customerId])
  @@index([productId])
  @@map("customer_product_prices") // Tên bảng trong PostgreSQL
}

model Supplier {
  id        String   @id @default(uuid())
  userId    String   // ID của chủ buôn quản lý nhà cung cấp này
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy String?  // ID của người trực tiếp tạo bản ghi này
  name      String   // Tên nhà cung cấp thịt (ví dụ: Lò mổ Hùng Vương, Cơ sở sỉ Anh Ba)
  phone     String?  // Số điện thoại liên hệ (có thể để trống)
  address   String?  // Địa chỉ của nhà cung cấp
  note      String?  // Ghi chú thêm
  isActive  Boolean  @default(true) // Trạng thái hoạt động (cho phép xóa mềm)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions SupplierTransaction[] // Các giao dịch nhập hàng nợ phát sinh
  payments     SupplierPayment[]     // Các giao dịch thanh toán trả nợ
  portalLinks  PortalLink[]          // Các link ghim Zalo dành cho nhà cung cấp này

  @@index([userId])
  @@map("suppliers")
}

model SupplierTransaction {
  id          String   @id @default(uuid())
  supplierId  String   // ID của nhà cung cấp
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdBy   String?  // ID của người trực tiếp tạo bản ghi này
  date        DateTime @default(now()) // Ngày nhập hàng / ghi nợ
  totalAmount Decimal  @db.Decimal(12, 2) // Số tiền hàng nhập (nợ phát sinh)
  note        String?  // Ghi chú chi tiết (ví dụ: nhập 200kg thịt ba chỉ)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([supplierId])
  @@map("supplier_transactions")
}

model SupplierPayment {
  id          String   @id @default(uuid())
  supplierId  String   // ID của nhà cung cấp được trả nợ
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdBy   String?  // ID của người trực tiếp tạo bản ghi này
  amount      Decimal  @db.Decimal(12, 2) // Số tiền trả nợ (VND)
  paidAt      DateTime @default(now()) // Ngày thanh toán tiền
  note        String?  // Ghi chú thanh toán (ví dụ: chuyển khoản Vietcombank)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([supplierId])
  @@map("supplier_payments")
}

model Employee {
  id          String   @id @default(uuid())
  userId      String   // ID của chủ buôn quản lý nhân viên này
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String   // Tên nhân viên
  phone       String?  // Số điện thoại
  address     String?  // Địa chỉ
  role        String?  // Vị trí công việc (ví dụ: Giao hàng, Lọc thịt, Bán sạp)
  baseSalary  Decimal  @db.Decimal(12, 2) // Lương cơ bản tháng (VND)
  isActive    Boolean  @default(true) // Trạng thái hoạt động (cho phép xóa mềm)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendances Attendance[] // Danh sách chấm công của nhân viên
  advances    SalaryAdvance[] // Các đợt tạm ứng lương
  payments    SalaryPayment[] // Bảng lương tháng chốt thực nhận

  @@index([userId])
  @@map("employees")
}

model Attendance {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime // Ngày chấm công (chỉ lấy phần ngày, bỏ giờ)
  status      String   // PRESENT (Đi làm), ABSENT (Nghỉ không phép)
  shift       String   @default("FULL") // FULL (Cả ngày = 1 công), HALF (Nửa ngày = 0.5 công)
  note        String?  // Ghi chú chấm công
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, date]) // Mỗi nhân viên chỉ chấm công 1 lần trong ngày
  @@index([employeeId])
  @@map("employee_attendances")
}

model SalaryAdvance {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2) // Số tiền tạm ứng (VND)
  date        DateTime @default(now()) // Ngày ứng lương
  note        String?  // Lý do ứng lương
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@map("employee_salary_advances")
}

model SalaryPayment {
  id               String    @id @default(uuid())
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  monthKey         String    // Tháng tính lương (ví dụ: "07/2026")
  baseSalary       Decimal   @db.Decimal(12, 2) // Mức lương gốc áp dụng
  workingDays      Decimal   @db.Decimal(5, 2)  // Tổng ngày công đi làm thực tế trong tháng
  advancesDeducted Decimal   @db.Decimal(12, 2) // Tiền tạm ứng khấu trừ
  bonus            Decimal   @db.Decimal(12, 2) @default(0) // Tiền thưởng thêm
  deductions       Decimal   @db.Decimal(12, 2) @default(0) // Khoản phạt/trừ đi
  finalAmount      Decimal   @db.Decimal(12, 2) // Thực lĩnh
  status           String    @default("PAID") // PAID (Đã chi trả), PENDING (Chưa thanh toán)
  paidAt           DateTime? // Ngày chi trả thực tế
  note             String?   // Ghi chú
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([employeeId, monthKey]) // Mỗi nhân viên chỉ chốt lương 1 lần duy nhất trong tháng
  @@index([employeeId])
  @@map("employee_salary_payments")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String   // ID của tài khoản thực hiện hành động
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // Loại hành động (ví dụ: 'CREATE_TRANSACTION', 'DELETE_PAYMENT')
  details   String   // Chi tiết mô tả hành động
  createdAt DateTime @default(now()) // Thời gian thực hiện hành động

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model InventoryProduct {
  id           String   @id @default(uuid())
  userId       String   // ID của chủ buôn sở hữu sản phẩm này
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy    String?  // ID của người trực tiếp tạo bản ghi này
  name         String   // Tên sản phẩm trong kho
  quantity     Decimal  @db.Decimal(12, 3) @default(0) // Số lượng tồn kho
  minQuantity  Decimal  @db.Decimal(12, 3) @default(0) // Định mức tồn tối thiểu để cảnh báo
  price        Decimal  @db.Decimal(12, 2) @default(0) // Giá nhập hàng gốc (giữ tương thích)
  importPrice  Decimal  @db.Decimal(12, 2) @default(0) // Giá nhập hàng (vốn)
  sellingPrice Decimal  @db.Decimal(12, 2) @default(0) // Giá bán ra
  unit         String   @default("cái") // Đơn vị tính
  isActive     Boolean  @default(true) // Trạng thái hoạt động (cho phép ẩn/xóa mềm)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  logs         InventoryLog[]
  shopSessionItems ShopSessionItem[]

  @@index([userId])
  @@map("inventory_products")
}

model InventoryLog {
  id           String           @id @default(uuid())
  userId       String           // ID của chủ buôn/workspace
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String           // ID của sản phẩm kho
  product      InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy    String?          // ID của người trực tiếp thực hiện thao tác
  type         String           // "IN" (Nhập hàng), "OUT" (Xuất kho), "ADJUST" (Kiểm kê/Cân bằng)
  quantity     Decimal          @db.Decimal(12, 3) // Số lượng thay đổi (số dương)
  price        Decimal          @default(0) @db.Decimal(12, 2) // Đơn giá tại thời điểm thực hiện (nếu có)
  previousQty  Decimal          @db.Decimal(12, 3) // Số lượng tồn trước khi thao tác
  newQty       Decimal          @db.Decimal(12, 3) // Số lượng tồn sau khi thao tác
  reason       String?          // Lý do (Dùng cho quán, Bán lẻ, Hư hỏng, Nhập mua mới, Cân bằng kiểm kê...)
  createdAt    DateTime         @default(now())

  @@index([userId])
  @@index([productId])
  @@index([createdAt])
  @@map("inventory_logs")
}

model ShopTable {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy   String?  // ID của người trực tiếp tạo bản ghi này
  name        String   // Tên bàn/phòng (VD: Bàn 1, Phòng VIP 2)
  pricePerHour Int     // Giá tiền 1 tiếng (VND)
  isActive    Boolean  @default(true)
  sessions    ShopSession[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("shop_tables")
}

model ShopSession {
  id          String    @id @default(uuid())
  tableId     String
  table       ShopTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy   String?   // ID của người trực tiếp tạo bản ghi này
  startTime   DateTime  // Giờ bắt đầu
  endTime     DateTime? // Giờ kết thúc (null = đang chơi)
  extraAmount Int       @default(0)  // Phụ thu thêm (nước, snack...)
  extraNote   String?   // Ghi chú khoản phụ thu
  isPaid      Boolean   @default(false)
  paidAt      DateTime?
  totalAmount Int       @default(0)  // Thành tiền cuối cùng đã tính
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items       ShopSessionItem[]

  @@map("shop_sessions")
}

model ShopSessionItem {
  id          String           @id @default(uuid())
  sessionId   String
  session     ShopSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId   String
  product     InventoryProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Decimal          @db.Decimal(12, 3) // Số lượng sử dụng
  price       Decimal          @db.Decimal(12, 2) // Đơn giá tại thời điểm gọi
  amount      Decimal          @db.Decimal(12, 2) // Thành tiền (= quantity * price)
  createdAt   DateTime         @default(now())

  @@index([sessionId])
  @@index([productId])
  @@map("shop_session_items")
}

// --- HỆ THỐNG WORKSPACE ---

// Workspace: không gian làm việc chung do Chủ Nhà Hàng sở hữu
model Workspace {
  id          String   @id @default(uuid())
  ownerId     String   @unique           // Mỗi chủ chỉ có 1 workspace
  owner       User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String                     // Tên workspace (VD: "Nhà hàng Anh Tú")
  inviteCode  String   @unique           // Mã mời 8 ký tự ngẫu nhiên (QR encode mã này)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members      WorkspaceMember[]      // Danh sách thành viên đã tham gia
  joinRequests WorkspaceJoinRequest[] // Danh sách yêu cầu tham gia đang chờ

  @@map("workspaces")
}

// Thành viên của Workspace — lưu thông tin liên kết và phân quyền riêng từng người
model WorkspaceMember {
  id           String    @id @default(uuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation("WorkspaceMembers", fields: [userId], references: [id], onDelete: Cascade)

  // Phân quyền riêng của thành viên này trong workspace
  canManageCustomers Boolean @default(false)
  canManageDebt      Boolean @default(false)
  canManageBadDebt   Boolean @default(false)
  canManageEmployees Boolean @default(false)
  canManageStore     Boolean @default(false)
  canManageInventory Boolean @default(false)
  canManageShop      Boolean @default(false)

  joinedAt     DateTime  @default(now())

  @@unique([workspaceId, userId]) // Mỗi user chỉ có 1 bản ghi thành viên trong 1 workspace
  @@index([userId])
  @@map("workspace_members")
}

// Yêu cầu tham gia workspace (chờ chủ phê duyệt)
model WorkspaceJoinRequest {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("WorkspaceJoinRequests", fields: [userId], references: [id], onDelete: Cascade)
  status      String    @default("pending") // "pending" | "approved" | "rejected"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, userId]) // Mỗi user chỉ có 1 yêu cầu tham gia trong 1 workspace
  @@index([workspaceId])
  @@map("workspace_join_requests")
}

// ─── ĐƠN NỢ CỐ ĐỊNH HÀNG NGÀY (TỰ ĐỘNG LÊN ĐƠN LÚC 0:30 HÀNG NGÀY) ───
model RecurringDebt {
  id            String   @id @default(uuid())
  userId        String   // ID của chủ buôn sở hữu mẫu đơn nợ cố định
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy     String?  // ID của người trực tiếp tạo mẫu đơn này
  customerId    String   // ID của khách hàng
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  note          String?  // Ghi chú đơn nợ cố định
  totalAmount   Decimal  @db.Decimal(12, 2) // Tổng giá trị đơn hàng
  profitPercent Decimal? @db.Decimal(5, 2)  // % lợi nhuận (nếu là ghi nợ nhanh)
  totalCost     Decimal  @default(0) @db.Decimal(12, 2) // Tổng tiền vốn
  totalProfit   Decimal  @default(0) @db.Decimal(12, 2) // Tổng tiền lãi
  isActive      Boolean  @default(true) // Trạng thái kích hoạt (mặc định true)
  lastGeneratedAt DateTime? // Thời điểm lần gần nhất cron tự sinh đơn nợ

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Các quan hệ liên kết
  items         RecurringDebtItem[]

  @@index([userId])
  @@index([customerId])
  @@map("recurring_debts")
}

model RecurringDebtItem {
  id              String        @id @default(uuid())
  recurringDebtId String        // ID đơn nợ cố định
  recurringDebt   RecurringDebt @relation(fields: [recurringDebtId], references: [id], onDelete: Cascade)
  productId       String        // ID sản phẩm thịt
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity        Decimal       @db.Decimal(10, 3) // Số lượng bán (kg/bộ/...)
  price           Decimal       @db.Decimal(12, 2) // Đơn giá bán
  costPrice       Decimal       @default(0) @db.Decimal(12, 2) // Đơn giá vốn
  amount          Decimal       @db.Decimal(12, 2) // Thành tiền
  profit          Decimal       @default(0) @db.Decimal(12, 2) // Tiền lãi

  @@index([recurringDebtId])
  @@index([productId])
  @@map("recurring_debt_items")
}

// ─── CỔNG TRA CỨU CÔNG NỢ & BẢNG GIÁ QUA LINK GHIM ZALO (PORTAL) ───
model PortalLink {
  id           String   @id @default(uuid())
  userId       String   // ID của chủ buôn sở hữu link này
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name         String   // Tên nhóm Zalo hiển thị (VD: "Nhóm Trường Hoàng", "Bún riêu Ngọc Lâm")
  token        String   @unique // Mã token ngẫu nhiên không thể đoán trước để truy cập link
  type         String   @default("customer") // "customer" (Xem đơn nợ/giá bán ra) hoặc "supplier" (Xem tiền hàng mua nợ NCC)
  
  pin          String?  // Mã PIN bảo mật (nếu có, 4 số)
  isActive     Boolean  @default(true) // Bật / Tắt hiệu lực của link
  
  // Liên kết nhiều khách hàng (dành cho nhóm chuỗi như Trường Hoàng)
  customers    PortalLinkCustomer[]
  
  // Liên kết nhà cung cấp (nếu type == "supplier")
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  
  note         String?  // Ghi chú nội bộ của chủ buôn
  viewCount    Int      @default(0) // Số lượt mở link
  lastViewedAt DateTime? // Thời điểm xem gần nhất
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  feedbacks    PortalFeedback[]

  @@index([userId])
  @@index([token])
  @@map("portal_links")
}

model PortalLinkCustomer {
  id           String     @id @default(uuid())
  portalLinkId String     // ID của link ghim Zalo
  portalLink   PortalLink @relation(fields: [portalLinkId], references: [id], onDelete: Cascade)
  customerId   String     // ID của khách hàng thuộc nhóm này
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime   @default(now())

  @@unique([portalLinkId, customerId])
  @@index([portalLinkId])
  @@index([customerId])
  @@map("portal_link_customers")
}

model PortalFeedback {
  id           String     @id @default(uuid())
  portalLinkId String     // ID của link phát sinh phản hồi
  portalLink   PortalLink @relation(fields: [portalLinkId], references: [id], onDelete: Cascade)
  
  customerId   String?    // Cơ sở phát sinh phản hồi (nếu là nhóm chuỗi)
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  senderName   String?    // Tên người gửi phản hồi (thu ngân, kế toán, quản lý quán)
  phone        String?    // SĐT liên hệ của người gửi
  type         String     @default("DISCREPANCY") // "DISCREPANCY" (Lệch tiền/cân), "PRICE_INQUIRY" (Hỏi giá), "PAYMENT_CONFIRM" (Báo đã CK), "OTHER" (Góp ý)
  content      String     // Nội dung phản hồi chi tiết
  imageUrls    String?    // Chuỗi JSON danh sách link ảnh hoặc base64 (ảnh chụp cân, bill chuyển khoản)
  
  status       String     @default("pending") // "pending" (Chờ duyệt), "resolved" (Đã xử lý), "rejected" (Bác bỏ)
  adminNote    String?    // Ghi chú xử lý của chủ buôn
  resolvedAt   DateTime?  // Thời điểm giải quyết
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([portalLinkId])
  @@index([customerId])
  @@index([status])
  @@map("portal_feedbacks")
}

model TransactionInvoice {
  id            String       @id @default(uuid())
  userId        String       // ID của chủ buôn quản lý
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String?      // ID của đơn nợ được đính kèm (nếu đã có đơn nợ trong ngày)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  customerId    String       // ID của khách hàng
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  date          DateTime     // Ngày của hóa đơn (dùng để đối chiếu với ngày của đơn nợ)
  imageUrl      String       // Đường dẫn ảnh hóa đơn (/uploads/invoices/...)
  note          String?      // Ghi chú thêm cho ảnh hóa đơn
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([transactionId])
  @@index([customerId])
  @@index([date])
  @@map("transaction_invoices")
}

// ─── LINK DÀNH CHO NHÓM NHÂN VIÊN GỬI HÓA ĐƠN & VIDEO QUA ZALO ───
model StaffSubmissionLink {
  id           String   @id @default(uuid())
  userId       String   // ID của chủ buôn sở hữu link
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name         String   // Tên nhóm/link hiển thị (VD: "Nhóm giao hàng chợ Sáng", "Nhân viên sạp A")
  token        String   @unique // Mã token ngẫu nhiên không thể đoán trước để truy cập link
  pin          String?  // Mã PIN bảo mật (nếu có)
  isActive     Boolean  @default(true) // Bật / Tắt hiệu lực link
  note         String?  // Ghi chú nội bộ
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions  StaffSubmission[]

  @@index([userId])
  @@index([token])
  @@map("staff_submission_links")
}

// ─── TỪNG HÓA ĐƠN / VIDEO DO NHÂN VIÊN GỬI LÊN ───
model StaffSubmission {
  id              String               @id @default(uuid())
  userId          String               // ID của chủ buôn
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkId          String?              // Thuộc link nào
  link            StaffSubmissionLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  senderName      String?              // Tên người gửi (nhân viên)
  note            String?              // Ghi chú đợt gửi
  fileUrl         String               // Link Cloudinary hoặc đường dẫn ảnh/video
  fileType        String               @default("IMAGE") // "IMAGE" | "VIDEO"
  date            DateTime             @default(now()) // Ngày của hóa đơn

  // Trạng thái xử lý:
  // "PENDING": Đã nhận file, chờ đưa vào hàng đợi AI
  // "ANALYZING": Đang gọi Gemini AI phân tích
  // "READY_FOR_REVIEW": Đã phân tích xong, đang chờ chủ buôn kiểm tra duyệt
  // "APPROVED": Chủ buôn đã duyệt thành công thành đơn nợ
  // "REJECTED": Chủ buôn bác bỏ / xóa bỏ
  status          String               @default("PENDING")

  // Kết quả nhận diện sơ bộ của AI
  detectedCustomerName String?         // Tên khách AI đọc được trên hóa đơn
  matchedCustomerId    String?         // ID khách hàng so khớp được trong danh bạ
  matchedCustomer      Customer?       @relation(fields: [matchedCustomerId], references: [id], onDelete: SetNull)
  rawAiResponse        String?         // JSON kết quả trả về từ Gemini AI
  aiError              String?         // Lỗi nếu Gemini không phân tích được

  // Liên kết đơn nợ sau khi duyệt
  transactionId   String?              // ID giao dịch được tạo sau khi duyệt
  approvedAt      DateTime?            // Thời điểm chủ buôn duyệt
  
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  items           StaffSubmissionItem[]

  @@index([userId])
  @@index([linkId])
  @@index([status])
  @@index([date])
  @@map("staff_submissions")
}

// ─── CHI TIẾT CÁC MÓN THỊT DO AI PHÂN TÍCH TRONG TỪNG HÓA ĐƠN ───
model StaffSubmissionItem {
  id              String          @id @default(uuid())
  submissionId    String          // Thuộc đợt gửi nào
  submission      StaffSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  rawName         String          // Tên món gốc AI đọc được từ tích kê
  matchedProductId String?        // ID sản phẩm thịt so khớp được trong danh mục
  quantity        Decimal?        @db.Decimal(10, 3) // Khối lượng (kg)
  price           Decimal?        @db.Decimal(12, 2) // Đơn giá
  amount          Decimal?        @db.Decimal(12, 2) // Thành tiền

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([submissionId])
  @@map("staff_submission_items")
}

